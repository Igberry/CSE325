@model IEnumerable<MovieApp.Models.Movie>

@{
    ViewData["Title"] = "Movie Catalog";
}

<h1>@ViewData["Title"]</h1>

<form method="get" class="row g-3 mb-3">
    <div class="col-md-5">
        <label class="form-label">Search by title</label>
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Released after year</label>
        <input type="number" name="year" value="@(ViewData["YearFilter"] ?? string.Empty)" class="form-control" />
    </div>
    <div class="col-md-4 align-self-end">
        <button type="submit" class="btn btn-primary me-2">Filter</button>
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-success">Add New Movie</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Genre</th>
            <th>Release Year</th>
            <th>Rating</th>
            <th>Director</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Genre</td>
                <td>@item.ReleaseYear</td>
                <td>@item.Rating</td>
                <td>@item.Director</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-1">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary me-1">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
