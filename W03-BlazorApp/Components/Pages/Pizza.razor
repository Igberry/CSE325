@page "/pizza"
@using W03_BlazorApp.Models
@using W03_BlazorApp.Services
@using W03_BlazorApp.Components.Pages.Shared
@inject PizzaService PizzaService
@inject OrderState OrderState
@inject NavigationManager NavigationManager

<PageTitle>Pizza Specials</PageTitle>

<h1>Fresh Pizza Specials</h1>
<p>Choose from our favorite handcrafted pizzas and enjoy them with your family.</p>

<div class="row g-4">
    @foreach (var pizza in Pizzas)
    {
        <div class="col-md-4">
            <PizzaCard Pizza="pizza" OnOrder="HandleOrder" />
        </div>
    }
</div>

@if (SelectedPizza is not null)
{
    <div class="order-dialog">
        <h3>Order @SelectedPizza.Name</h3>
        <p>@SelectedPizza.Description</p>
        <label for="customerName">Your name</label>
        <input id="customerName" class="form-control" @bind="CustomerName" />
        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-success" @onclick="PlaceOrder">Confirm Order</button>
            <button class="btn btn-outline-secondary" @onclick="CancelOrder">Cancel</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(OrderMessage))
        {
            <p class="mt-3 text-success">@OrderMessage</p>
        }
    </div>
}

@code {
    private List<PizzaSpecial> Pizzas = new();
    private PizzaSpecial? SelectedPizza;
    private string CustomerName = string.Empty;
    private string OrderMessage = string.Empty;

    protected override void OnInitialized()
    {
        Pizzas = PizzaService.GetSpecials().ToList();
    }

    private void HandleOrder(PizzaSpecial pizza)
    {
        SelectedPizza = pizza;
        CustomerName = string.Empty;
        OrderMessage = string.Empty;
    }

    private void PlaceOrder()
    {
        if (SelectedPizza is null)
        {
            return;
        }

        OrderState.AddPizza(SelectedPizza);
        var order = OrderState.PlaceOrder(CustomerName.Trim());
        OrderMessage = $"Thanks {CustomerName.Trim() ?? "friend"}! Your {SelectedPizza.Name} is on the way.";
        NavigationManager.NavigateTo($"/checkout/{order.Id}");
    }

    private void CancelOrder()
    {
        SelectedPizza = null;
        CustomerName = string.Empty;
        OrderMessage = string.Empty;
    }
}
