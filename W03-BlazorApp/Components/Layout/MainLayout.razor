@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="fw-bold">David's Pizza Shop</span>
            <nav class="d-flex gap-3">
                <NavLink href="" Match="NavLinkMatch.All" class="nav-link">Home</NavLink>
                <NavLink href="pizza" class="nav-link">Pizza</NavLink>
                <NavLink href="myorders" class="nav-link">My Orders</NavLink>
            </nav>
        </div>

        <article class="content px-4">
            @Body
        </article>

        <footer class="footer mt-5 px-4 py-3 border-top text-muted">
            <div class="container-fluid">
                <span>David Nguyen | United States</span>
            </div>
        </footer>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
