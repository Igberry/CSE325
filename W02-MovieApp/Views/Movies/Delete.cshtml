@model MovieApp.Models.Movie

@{
    ViewData["Title"] = "Delete Movie";
}

<h1>@ViewData["Title"]</h1>

<h4>Are you sure you want to delete this movie?</h4>
<div class="card mb-3">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">Genre</dt>
            <dd class="col-sm-9">@Model.Genre</dd>

            <dt class="col-sm-3">Release Year</dt>
            <dd class="col-sm-9">@Model.ReleaseYear</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
